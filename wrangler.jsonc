{
  "name": "alvert",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "alvert-bilder" }
  ]
}
